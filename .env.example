# ═══════════════════════════════════════════════════════════════════
#  .env.example — шаблон переменных окружения для сервера «Аккреции».
#
#  ВАЖНО: server.js НЕ использует dotenv — переменные читаются напрямую
#  из process.env. Задавайте их в панели хостинга (Render → Environment)
#  или через менеджер процессов (systemd, pm2, docker compose env).
#  Этот файл — только справка, не копируйте его как реальный .env.
# ═══════════════════════════════════════════════════════════════════

# ─── Обязательные (без них сервер не стартует) ────────────────────
BOT_TOKEN=1234567890:AA...
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=AA...

# ─── Критично для оплаты (после фикса вебхука) ────────────────────
# Токен Telegram Webhook (поле X-Telegram-Bot-API-Secret-Token).
# Без него /webhook отклоняет ВСЕ callback'и оплаты (fail-closed):
# покупки не будут выдаваться. Сгенерируйте длинную случайную строку.
WEBHOOK_SECRET=

# ─── Порт и админка ───────────────────────────────────────────────
# Порт (на Render обычно задаёт сам хостинг через $PORT)
# PORT=10000

# Токен админ-панели. Если не задан — /admin и /admin/api/* отключены.
ADMIN_TOKEN=

# ─── CORS ─────────────────────────────────────────────────────────
# Разрешённые источники для сайта игры (через запятую).
# Если не задано — CORS «*» (открыто). В проде лучше указать домен(ы).
ALLOWED_ORIGIN=https://YOUR-USERNAME.github.io

# ─── Серверный кошелёк (включать поэтапно, см. DEPLOY.md) ─────────
# SERVER_AUTHORITATIVE=1 — сервер ведёт баланс пыли/энергии/цив/металлов
# SERVER_AUTHORITATIVE=

# Доля лимита ресурса, которую можно «добрать» за одну сверку (награды клиента)
# WALLET_ALLOWANCE_SHARE=0.05

# Во сколько раз «прочий» доход (миссии/кометы/события) может превышать пассивный
# REWARD_EXTRA_SHARE=2.0

# Античит по кликам: максимум кликов в секунду на игрока
# MAX_CLICKS_PER_SEC=30

# ─── Проверка «оплаченных возможностей» (планеты/системы) ─────────
# CAPABILITY_ENFORCE=1 — необоснованный прирост планет/систем отклоняется (409)
# CAPABILITY_ENFORCE=

# Коэффициенты пересчёта трат энергии/цивилизации в пыль для capability-аудита
# ENERGY_TO_DUST=1000000
# CIV_TO_DUST=1000000000
